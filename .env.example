# Copy to backend/.env for local development. Every variable is prefixed FORGE_.
# Production uses the same names, set in Render -- see DEPLOY.md.

# --- application ---------------------------------------------------------
FORGE_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside development the app refuses to start with this default, or with
# anything under 32 bytes.
FORGE_SECRET_KEY=dev-only-change-me
# One URL, a comma-separated list, or a JSON list. No trailing slash.
FORGE_CORS_ORIGINS=http://localhost:4200
# Optional: also admit any origin matching this regex, e.g. Vercel previews.
# FORGE_CORS_ORIGIN_REGEX=^https://resumeforge-[a-z0-9-]+\.vercel\.app$

# --- database ------------------------------------------------------------
# SQLite needs nothing running; tables are created at startup in development.
FORGE_DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Local Postgres (docker compose up -d postgres). Postgres is only ever changed
# by migrations, so run `alembic upgrade head` from backend/ first:
# FORGE_DATABASE_URL=postgresql://forge:forge@localhost:5432/resumeforge
# Hosted Postgres: paste the string exactly as Neon shows it. sslmode and
# channel_binding are translated for asyncpg automatically.

# --- model provider ------------------------------------------------------
# "anthropic" or "groq". The pipeline, the schemas and the guards are the
# same either way, so the no-hallucination guarantee does not depend on it.
#
# Anthropic is what the prompts were tuned against and gives better rewrites.
# Groq has a free tier and runs open models; its free tier allows 8,000
# tokens/minute, which one generation can exhaust -- rate limits are retried
# automatically, so a run takes longer rather than failing.
FORGE_LLM_PROVIDER=anthropic

# Needed when FORGE_LLM_PROVIDER=anthropic. Get one at console.anthropic.com.
FORGE_ANTHROPIC_API_KEY=sk-ant-...
FORGE_MODEL=claude-opus-5
FORGE_EFFORT=high

# Needed when FORGE_LLM_PROVIDER=groq. Get one at console.groq.com.
# The model must support strict structured outputs.
FORGE_GROQ_API_KEY=gsk_...
FORGE_GROQ_MODEL=openai/gpt-oss-120b

# --- object storage (optional) --------------------------------------------
# Enables PDF download. Leave unset and tailoring still works; the .tex is
# offered instead. For local MinIO (docker compose up -d minio):
# FORGE_S3_ENDPOINT_URL=http://localhost:9000
# FORGE_S3_ACCESS_KEY=minioadmin
# FORGE_S3_SECRET_KEY=minioadmin
# FORGE_S3_BUCKET=resumeforge
# FORGE_S3_REGION=auto

# --- compilation -----------------------------------------------------------
# auto | tectonic | docker
FORGE_COMPILE_BACKEND=auto
FORGE_COMPILE_TIMEOUT_SECONDS=90
FORGE_MAX_COMPILE_ATTEMPTS=3
