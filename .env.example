# Copy to backend/.env and fill in. Every value is prefixed FORGE_.

# --- required ---------------------------------------------------------
# Without this the pipeline cannot run. Get one at console.anthropic.com.
FORGE_ANTHROPIC_API_KEY=sk-ant-...

# --- application ------------------------------------------------------
FORGE_ENVIRONMENT=development
FORGE_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Refused at startup outside development if left as the default or under
# 32 bytes.
FORGE_SECRET_KEY=dev-only-change-me
FORGE_CORS_ORIGINS=["http://localhost:4200"]

# --- database ---------------------------------------------------------
# Local (docker-compose):
FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/resumeforge
# Production (Neon) -- note Render's own free Postgres expires after 30 days:
# FORGE_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/resumeforge?ssl=require

# --- object storage ---------------------------------------------------
# Local (MinIO):
FORGE_S3_ENDPOINT_URL=http://localhost:9000
FORGE_S3_ACCESS_KEY=minioadmin
FORGE_S3_SECRET_KEY=minioadmin
FORGE_S3_BUCKET=resumeforge
FORGE_S3_REGION=auto
# Production (Cloudflare R2):
# FORGE_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# FORGE_S3_ACCESS_KEY=<r2-access-key-id>
# FORGE_S3_SECRET_KEY=<r2-secret-access-key>

# --- model ------------------------------------------------------------
FORGE_MODEL=claude-opus-5
FORGE_EFFORT=high

# --- compilation ------------------------------------------------------
# auto | tectonic | docker
FORGE_COMPILE_BACKEND=auto
FORGE_COMPILE_TIMEOUT_SECONDS=90
FORGE_MAX_COMPILE_ATTEMPTS=3
